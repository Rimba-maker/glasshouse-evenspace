---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.tsx';
import TheSpace from '../components/TheSpace.astro';
import VenueRooms from '../components/VenueRooms.tsx';
import EventTypes from '../components/EventTypes.tsx';
import CapacityLayout from '../components/CapacityLayout.tsx';
import Packages from '../components/Packages.tsx';
import Gallery from '../components/Gallery.tsx';
import PreferredVendors from '../components/PreferredVendors.tsx';
import Location from '../components/Location.astro';
import Testimonial from '../components/Testimonial.tsx';
import SiteVisit from '../components/SiteVisit.tsx';
import Footer from '../components/Footer.astro';
---

<Layout title="The Glasshouse Event Space — Intimate Wedding & Event Venue Jakarta">
	<Navbar />
	<main class="w-full">
		<Hero client:load />
		<TheSpace />
		<VenueRooms client:visible />
		<EventTypes client:visible />
		<CapacityLayout client:visible />
		<Packages client:visible />
		<Gallery client:visible />
		<PreferredVendors client:visible />
		<Location />
		<Testimonial client:visible />
		<SiteVisit client:idle />
	</main>
	<Footer />
</Layout>
