---
// src/components/Footer.astro
import { photoList } from '../shared/photos';

const year = new Date().getFullYear();
const credits = [...new Map(photoList.map((p) => [p.pexels, p])).values()];
---

<footer class="footer">
	<div class="container">
		<p class="footer__mast">The Glasshouse<br /><span class="footer__tag">“Light up your milestone.”</span></p>

		<div class="footer__cols">
			<div>
				<h2>Operating hours</h2>
				<ul>
					<li>09:00-22:00 (booking)</li>
					<li>24/7 (event)</li>
				</ul>
			</div>
			<div>
				<h2>Menu</h2>
				<ul>
					<li><a href="#space">Space</a></li>
					<li><a href="#events">Event Types</a></li>
					<li><a href="#packages">Packages</a></li>
					<li><a href="#gallery">Gallery</a></li>
				</ul>
			</div>
			<div>
				<h2>Connect</h2>
				<ul>
					<li><a href="#">Instagram</a> <span class="label">@theglasshouse.id</span></li>
					<li><a href="#">Pinterest</a></li>
					<li><a href="#">TikTok</a></li>
				</ul>
			</div>
			<div>
				<h2>Partner</h2>
				<ul>
					<li>Bridestory</li>
					<li>The Bride Department</li>
					<li>Hipwee Wedding</li>
				</ul>
			</div>
		</div>

		<div class="footer__legal">
			<p>&copy; {year} The Glasshouse Event Space. All rights reserved.</p>
			<div style="display: flex; gap: var(--space-lg);">
				<a href="#">Privacy Policy</a>
				<a href="#">Terms of Service</a>
			</div>
		</div>

		<p class="footer__credits" data-credits>
			Photographs: foto stand-in dari Pexels, ganti dengan foto The Glasshouse sendiri.
		</p>
		<ul class="footer__credit-list">
			{credits.map((c, i) => (
				<li><a href={`https://www.pexels.com/photo/${c.pexels}/`} rel="noopener" class="text-link" aria-label={`Foto ${i + 1} di Pexels`}>{i + 1}</a></li>
			))}
		</ul>
	</div>
</footer>
