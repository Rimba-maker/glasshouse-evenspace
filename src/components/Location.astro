---
// src/components/Location.astro
---

<section id="location" class="py-20 md:py-[120px] bg-canvas-white px-6 border-t border-black/5">
  <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row gap-10 md:gap-16 items-center">
    
    <!-- Text Content -->
    <div class="flex-1 space-y-5 md:space-y-6">
      <h2 class="text-3xl md:text-5xl font-semibold tracking-tighter text-ink">Lokasi</h2>
      <p class="text-base md:text-lg text-ink/80 leading-relaxed">
        The Glasshouse berada di Cilandak, Jakarta Selatan — 15 menit dari Pondok Indah Mall, 30 menit dari Bandara Halim, 45 menit dari Bandara Soetta.
      </p>
      
      <div class="space-y-4 pt-2 md:pt-4">
        <div>
          <h4 class="text-xs md:text-sm font-semibold uppercase tracking-wide text-ink/50 mb-1">Alamat</h4>
          <p class="text-base md:text-lg font-medium text-ink">Jl. Cilandak KKO No. 88, Jakarta Selatan</p>
        </div>
        <div>
          <h4 class="text-xs md:text-sm font-semibold uppercase tracking-wide text-ink/50 mb-1">Fasilitas Parkir</h4>
          <p class="text-base md:text-lg font-medium text-ink">60 mobil + 40 motor on-site<br/><span class="text-ink/70 text-sm md:text-base font-normal">Overflow valet partner tersedia</span></p>
        </div>
      </div>

      <div class="pt-4">
        <a href="#" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-canvas-parchment md:bg-transparent px-6 py-4 md:p-0 rounded-full md:rounded-none text-action-blue font-semibold md:font-medium hover:underline underline-offset-4 min-h-[44px]">
          Buka di Google Maps
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Map Placeholder -->
    <div class="flex-1 w-full mt-6 md:mt-0">
      <div class="aspect-square md:aspect-[4/3] bg-canvas-parchment rounded-[32px] overflow-hidden relative shadow-[var(--shadow-product)] border border-black/5">
        <img 
          src="https://images.pexels.com/photos/37347/office-sitting-room-executive-sitting.jpg?auto=compress&cs=tinysrgb&w=1200" 
          alt="Map Location" 
          class="absolute inset-0 w-full h-full object-cover opacity-80"
        />
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-12 h-12 bg-action-blue rounded-full text-white flex items-center justify-center shadow-lg transform -translate-y-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
