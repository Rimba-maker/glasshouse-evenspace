---
// src/components/TheSpace.astro
import { photos, src } from '../shared/photos';

const highlights = [
	{ title: 'Natural Sunlight All Day', note: 'Dinding kaca dari lantai ke atap' },
	{ title: 'Indoor Garden Concept', note: 'Pohon tumbuh menembus atap' },
	{ title: 'Photo-Ready Every Corner', note: 'Fotogenik, tetap fungsional' },
];
const figures = [
	{ value: '350 m²', label: 'Main Hall' },
	{ value: '30-150', label: 'Kapasitas tamu' },
	{ value: '2021', label: 'Tahun dibangun' },
	{ value: '500+', label: 'Events hosted', accent: true },
	{ value: '4.9', label: 'Rating' },
	{ value: '7 hari', label: 'Available 7 days a week' },
];
---

<section id="space" class="section">
	<div class="container">
		<div class="grid12">
			<div class="span-7">
				<h2>Lebih Dari Sekadar Venue</h2>
				<p class="lead" style="margin-top: var(--space-lg);">
					The Glasshouse adalah ruang dimana kaca, kayu, dan hijau bertemu, dibangun di tahun 2021 dengan visi sederhana: menciptakan tempat dimana cahaya alami menjadi dekorasi terbaik. Setiap sudut dirancang untuk fotogenik, namun tetap fungsional. Tidak ada plafon palsu, tidak ada karpet artificial, hanya pohon yang sengaja dibiarkan tumbuh menembus atap, lantai kayu Jati, dan dinding kaca yang memberi 360° view taman.
				</p>
			</div>
			<ul class="index space__rows span-5" style="align-self: end;">
				{highlights.map((h) => (
					<li>
						<h3>{h.title}</h3>
						<span class="label">{h.note}</span>
					</li>
				))}
			</ul>
		</div>

		<figure class="photo space__strip">
			<div data-slot="space" data-alt={photos.space.alt}>
				<img src={src(photos.space.file)} alt={photos.space.alt} loading="lazy" />
			</div>
		</figure>

		<div class="figures">
			{figures.map((f) => (
				<div>
					<span class:list={['figure', f.accent && 'figure--accent']}>{f.value}</span>
					<span class="label">{f.label}</span>
				</div>
			))}
		</div>
	</div>
</section>
