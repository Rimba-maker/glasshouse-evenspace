---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "The Glasshouse Event Space - Intimate Wedding & Event Venue Jakarta" } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-canvas-parchment text-ink min-h-screen flex flex-col">
		<slot />
	</body>
</html>
